# ---------------------------------------------------------------------------
#   preferências do próprio app e arquivos
# ---------------------------------------------------------------------------

def ler_prefs_app():
    try:
        with open(PREFS_APP, encoding="utf-8") as f:
            dados = json.load(f)
        return dados if isinstance(dados, dict) else {}
    except (OSError, ValueError):
        return {}


def gravar_prefs_app(**valores):
    dados = ler_prefs_app()
    dados.update(valores)
    os.makedirs(os.path.dirname(PREFS_APP), exist_ok=True)
    with open(PREFS_APP, "w", encoding="utf-8") as f:
        json.dump(dados, f, indent=2, ensure_ascii=False)
        f.write("\n")


def ler_texto(caminho, padrao=""):
    try:
        with open(caminho, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return padrao


def gravar_texto(caminho, texto):
    """Grava num .tmp e renomeia: quem estiver lendo nunca vê o arquivo pela metade."""
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    tmp = caminho + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(texto)
    os.replace(tmp, caminho)


def garantir_do_skel(caminho, relativo, base=SKEL):
    """Usuário sem o arquivo (skel não copiado): parte do padrão VoidBR."""
    if not os.path.exists(caminho):
        origem = os.path.join(base, relativo)
        if os.path.exists(origem):
            os.makedirs(os.path.dirname(caminho), exist_ok=True)
            shutil.copy2(origem, caminho)


def sim(v):
    return str(v).strip().lower() in ("yes", "true", "on", "1", "enabled")


def num(texto, padrao):
    try:
        return int(float(texto))
    except (TypeError, ValueError):
        return padrao


# ---------------------------------------------------------------------------
#   config do Sway: leitura (o valor que vale é o último lido, como no sway)
# ---------------------------------------------------------------------------

TECLA_AREA = re.compile(r"^Mod4\+(Shift\+)?([0-9])$", re.I)


def _partes(linha):
    try:
        return shlex.split(linha, comments=False, posix=True)
    except ValueError:
        return linha.split()


def _expandir(caminho):
    return os.path.expanduser(os.path.expandvars(caminho))


def sway_ler(caminho=None, estado=None, vars_=None, profundidade=0):
    """Lê o config (e os include) e devolve só o que o app ajusta."""
    if estado is None:
        estado = {"teclado": {}, "touchpad": {}, "areas": {}}
        vars_ = {}
        caminho = caminho or SWAY_CONF
    if profundidade > 6:
        return estado
    pilha = []
    for bruta in ler_texto(caminho).splitlines():
        linha = bruta.strip()
        if not linha or linha.startswith("#"):
            continue
        if linha == "}":
            if pilha:
                pilha.pop()
            continue
        abre = linha.endswith("{")
        if abre:
            linha = linha[:-1].strip()
        partes = [re.sub(r"\$\w+", lambda m: vars_.get(m.group(0), m.group(0)), p)
                  for p in _partes(linha)]
        if abre:
            pilha.append(partes)
            continue
        cmd = [p for bloco in pilha for p in bloco] + partes
        if not cmd:
            continue
        _sway_comando(cmd, estado, vars_, caminho, profundidade)
    return estado


def _sway_comando(cmd, e, vars_, caminho, profundidade):
    c, args = cmd[0], cmd[1:]
    if c == "set" and len(args) >= 2 and args[0].startswith("$"):
        vars_[args[0]] = " ".join(args[1:])
    elif c == "include" and args:
        alvo = _expandir(" ".join(args))
        if not os.path.isabs(alvo):
            alvo = os.path.join(os.path.dirname(caminho), alvo)
        for arq in sorted(glob.glob(alvo)):
            sway_ler(arq, e, vars_, profundidade + 1)
    elif c == "gaps" and len(args) >= 2 and args[0] in ("inner", "outer"):
        e["gaps_" + args[0]] = num(args[-1], 0)
    elif c in ("smart_gaps", "smart_borders", "focus_follows_mouse", "workspace_layout") and args:
        e[c] = args[0]
    elif c == "default_border" and args:
        e["borda"] = args[0]
        if len(args) > 1:
            e["borda_px"] = num(args[1], 2)
    elif c == "font" and args:
        e["fonte"] = " ".join(args).replace("pango:", "", 1).strip()
    elif c == "client.focused" and args:
        e["cor"] = args[0].lower()
    elif c == "seat" and len(args) >= 3 and args[1] == "xcursor_theme":
        e["cursor"] = args[2]
        if len(args) > 3:
            e["cursor_tam"] = num(args[3], 24)
    elif c == "output" and len(args) >= 3 and args[1] in ("bg", "background"):
        e["papel"] = _expandir(args[2])
        if len(args) > 3:
            e["papel_modo"] = args[3]
    elif c == "input" and len(args) >= 3:
        ident, chave, vals = args[0], args[1], args[2:]
        alvo = None
        if ident in ("type:keyboard", "*"):
            alvo = e["teclado"]
        if ident == "type:touchpad":
            alvo = e["touchpad"]
        if alvo is not None:
            alvo[chave] = " ".join(vals)
            if ident == "*" and chave in ("tap", "natural_scroll", "dwt", "pointer_accel"):
                e["touchpad"][chave] = " ".join(vals)
    elif c == "bindsym" and len(args) >= 4:
        opcoes = [a for a in args if a.startswith("--")]
        resto = [a for a in args if not a.startswith("--")]
        m = TECLA_AREA.match(resto[0]) if resto else None
        if not m or m.group(1):
            return
        acao = resto[1:]
        if acao[:2] == ["workspace", "number"] and len(acao) >= 3 and not opcoes:
            n = 10 if m.group(2) == "0" else int(m.group(2))
            e["areas"][n] = " ".join(acao[2:])


# ---------------------------------------------------------------------------
#   config do Sway: escrita (arquivo próprio + include no fim do config)
# ---------------------------------------------------------------------------

def sway_garantir_include():
    """O config do usuário precisa ler o config.d no fim (é o que deixa os
    ajustes valerem por cima). Desliga também o "exec_always swaymsg gaps"
    antigo do skel, que desfazia os espaços a cada recarga."""
    garantir_do_skel(SWAY_CONF, "sway/config")
    texto = ler_texto(SWAY_CONF)
    linhas = texto.splitlines()
    mudou = False
    saida = []
    for linha in linhas:
        if re.match(r"^\s*exec_always\s+swaymsg\s+gaps\s", linha):
            saida.append("# (desligado pelo voidbr-sway-tweaks) " + linha.strip())
            mudou = True
        else:
            saida.append(linha)
    tem = any(re.match(r"^\s*include\s+(~|\$HOME|" + re.escape(HOME) + r")/\.config/sway/config\.d",
                       linha) for linha in saida)
    if not tem:
        saida += ["", "# Ajustes do VoidBR Sway Tweaks (por último, valem por cima do resto)",
                  INCLUDE]
        mudou = True
    if mudou:
        gravar_texto(SWAY_CONF, "\n".join(saida).rstrip("\n") + "\n")


def _q(texto):
    """Aspas para o sway quando o valor tem espaço ou está vazio."""
    texto = str(texto)
    if texto and not re.search(r'[\s"\'#;,{}]', texto):
        return texto
    return '"' + texto.replace("\\", "\\\\").replace('"', '\\"') + '"'


def nome_area(n, nome):
    nome = (nome or "").strip()
    if not nome or nome == str(n):
        return str(n)
    return f"{n}:{nome}"


def tweaks_texto(v, secoes):
    """Monta o 90-voidbr-tweaks.conf só com as seções pedidas."""
    l = ["# voidbr-sway-tweaks: gerado pelo VoidBR Sway Tweaks — edite pelo app.",
         "# Lido no fim do ~/.config/sway/config (include) e vale por cima dele.", ""]
    if "janelas" in secoes:
        borda = v["borda"] if v["borda"] == "none" else f"{v['borda']} {v['borda_px']}"
        l += ["## Janelas",
              f"default_border {borda}",
              f"default_floating_border {borda}",
              f"gaps inner {v['gaps_inner']}",
              f"gaps outer {v['gaps_outer']}",
              f"smart_gaps {'on' if v['smart_gaps'] else 'off'}",
              f"smart_borders {'on' if v['smart_borders'] else 'off'}",
              f"focus_follows_mouse {'yes' if v['foco_mouse'] else 'no'}",
              f"workspace_layout {v['layout']}",
              f"font pango:{v['fonte_nome']} {v['fonte_tam']}"]
        cor = dict((k, c) for k, _r, c in CORES).get(v["cor"])
        if cor:
            # borda | fundo do título | texto | indicador | borda do filho
            l.append(f"client.focused {cor} {cor} #1a1b26 {cor} {cor}")
        l.append("")
    if "areas" in secoes:
        nomes = [n.strip() for n in v["areas_nomes"].split(",")]
        binds = []
        for n in range(1, 11):
            nome = nome_area(n, nomes[n - 1] if n - 1 < len(nomes) else "")
            if nome == str(n):
                continue  # sem nome: fica o atalho do config
            tecla = "0" if n == 10 else str(n)
            binds += [f"bindsym Mod4+{tecla} workspace number {_q(nome)}",
                      f"bindsym Mod4+Shift+{tecla} move container to workspace number {_q(nome)}"]
        if binds:
            l += ["## Áreas de trabalho (nomes)"] + binds + [""]
    if "aparencia" in secoes:
        l += ["## Cursor", f"seat * xcursor_theme {_q(v['cursor'])} {v['cursor_tam']}", ""]
    if "papel" in secoes and v.get("papel"):
        l += ["## Papel de parede", f"output * bg {_q(v['papel'])} {v['papel_modo']}", ""]
    if "teclado" in secoes:
        opcoes = [o for o in v.get("_xkb_opcoes", []) if not o.startswith("grp:")]
        if v["alternar"]:
            opcoes.insert(0, v["alternar"])
        l += ["## Teclado", "input type:keyboard {",
              f"    xkb_layout {_q(v['layouts'].replace(' ', '') or 'br')}",
              f"    xkb_variant {_q(v['variante'].replace(' ', ''))}",
              f"    xkb_model {v['modelo']}"]
        if opcoes:
            l.append(f"    xkb_options {_q(','.join(opcoes))}")
        l += [f"    xkb_numlock {'enabled' if v['numlock'] else 'disabled'}",
              f"    repeat_rate {v['repeticao']}",
              f"    repeat_delay {v['atraso']}", "}", ""]
    if "touchpad" in secoes:
        l += ["## Touchpad", "input type:touchpad {",
              f"    tap {'enabled' if v['toque'] else 'disabled'}",
              f"    natural_scroll {'enabled' if v['natural'] else 'disabled'}",
              f"    dwt {'enabled' if v['digitando'] else 'disabled'}",
              f"    pointer_accel {v['velocidade']:.1f}", "}", ""]
    return "\n".join(l).rstrip("\n") + "\n"


TODAS = ("janelas", "areas", "aparencia", "papel", "teclado", "touchpad")


def sway_validar():
    """None se o config está certo; senão, o texto do erro (sway -C)."""
    if not shutil.which("sway"):
        return None
    try:
        r = subprocess.run(["sway", "-C", "-c", SWAY_CONF], capture_output=True, text=True,
                           timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode == 0:
        return None
    erros = [x for x in (r.stderr + r.stdout).splitlines() if "ERROR" in x or "Error" in x]
    return "\n".join(erros[-4:]) or "configuração inválida"


def tweaks_gravar(v, secoes=TODAS):
    """Grava o arquivo, confere com sway -C e desfaz se o sway reclamar."""
    sway_garantir_include()
    antigo = ler_texto(TWEAKS_CONF, None)
    gravar_texto(TWEAKS_CONF, tweaks_texto(v, secoes))
    erro = sway_validar()
    if erro:
        if antigo is None:
            os.remove(TWEAKS_CONF)
        else:
            gravar_texto(TWEAKS_CONF, antigo)
        raise RuntimeError("O sway recusou a configuração e nada foi mudado:\n" + erro)


# ---------------------------------------------------------------------------
#   Waybar
# ---------------------------------------------------------------------------

def waybar_config():
    for nome in ("config", "config.jsonc"):
        c = os.path.join(WAYBAR_DIR, nome)
        if os.path.exists(c):
            return c
    c = os.path.join(WAYBAR_DIR, "config")
    garantir_do_skel(c, "waybar/config")
    return c


def sem_comentarios(texto):
    """Tira // e /* */ do JSONC sem mexer no que está dentro de aspas."""
    saida, i, n = [], 0, len(texto)
    while i < n:
        c = texto[i]
        if c == '"':
            j = i + 1
            while j < n and texto[j] != '"':
                j += 2 if texto[j] == "\\" else 1
            saida.append(texto[i:j + 1])
            i = j + 1
        elif texto.startswith("//", i):
            while i < n and texto[i] != "\n":
                i += 1
        elif texto.startswith("/*", i):
            fim = texto.find("*/", i + 2)
            i = n if fim < 0 else fim + 2
        else:
            saida.append(c)
            i += 1
    # vírgula sobrando antes de } ou ] (aceita pela Waybar, não pelo json)
    return re.sub(r",(\s*[}\]])", r"\1", "".join(saida))


def waybar_ler():
    caminho = waybar_config()
    try:
        dados = json.loads(sem_comentarios(ler_texto(caminho, "{}")))
    except ValueError:
        dados = {}
    if isinstance(dados, list):  # várias barras: o app ajusta a primeira
        dados = dados[0] if dados else {}
    return dados


def _pular(texto, i):
    """Índice depois de uma string, comentário ou caractere comum em i."""
    if texto[i] == '"':
        j = i + 1
        while j < len(texto) and texto[j] != '"':
            j += 2 if texto[j] == "\\" else 1
        return j + 1
    if texto.startswith("//", i):
        fim = texto.find("\n", i)
        return len(texto) if fim < 0 else fim
    if texto.startswith("/*", i):
        fim = texto.find("*/", i + 2)
        return len(texto) if fim < 0 else fim + 2
    return i + 1


def _fim_valor(texto, i):
    """Fim do valor JSON que começa em i (string, número, lista ou objeto)."""
    if texto[i] == '"':
        return _pular(texto, i)
    if texto[i] in "[{":
        nivel = 0
        while i < len(texto):
            c = texto[i]
            if c in "[{":
                nivel += 1
            elif c in "]}":
                nivel -= 1
                if nivel == 0:
                    return i + 1
            i = _pular(texto, i)
        return i
    m = re.compile(r"[^,\s}\]/]+").match(texto, i)
    return m.end() if m else i


def _chaves_topo(texto):
    """{chave: (início, fim) do valor} no primeiro objeto da config, e onde ele abre."""
    achadas, nivel, abre, i = {}, 0, None, 0
    alvo = None
    while i < len(texto):
        c = texto[i]
        if c in "[{":
            nivel += 1
            if alvo is None and c == "{":
                alvo, abre = nivel, i  # {…} solto ou o primeiro de [{…}, …]
            i += 1
        elif c in "]}":
            if nivel == alvo:
                break
            nivel -= 1
            i += 1
        elif c == '"' and nivel == alvo:
            fim = _pular(texto, i)
            m = re.compile(r"\s*:\s*").match(texto, fim)
            if m:
                chave = json.loads(texto[i:fim])
                ini = m.end()
                achadas.setdefault(chave, (ini, _fim_valor(texto, ini)))
                i = achadas[chave][1]
            else:
                i = fim
        else:
            i = _pular(texto, i)
    return achadas, abre


def _formatar(valor, antigo, recuo):
    """Lista/objeto em várias linhas se já estava assim; o resto numa linha só."""
    if isinstance(valor, (list, dict)) and valor and "\n" in antigo:
        return json.dumps(valor, indent=2, ensure_ascii=False).replace("\n", "\n" + recuo)
    return json.dumps(valor, ensure_ascii=False)


def waybar_gravar(mudancas):
    """Troca só os valores pedidos no texto do arquivo: comentários, ordem e o
    resto da config do usuário ficam como estão."""
    caminho = waybar_config()
    texto = ler_texto(caminho, "{}\n")
    for chave, valor in mudancas.items():
        achadas, abre = _chaves_topo(texto)
        if chave in achadas:
            ini, fim = achadas[chave]
            inicio_linha = texto.rfind("\n", 0, ini) + 1
            recuo = re.match(r"\s*", texto[inicio_linha:]).group(0)
            texto = texto[:ini] + _formatar(valor, texto[ini:fim], recuo) + texto[fim:]
        elif abre is not None:  # chave nova: entra logo depois do "{", no recuo das outras
            m = re.compile(r"[ \t]*\n([ \t]+)").match(texto, abre + 1)
            recuo = m.group(1) if m else "  "
            novo = f'\n{recuo}"{chave}": {json.dumps(valor, ensure_ascii=False)},'
            texto = texto[:abre + 1] + novo + texto[abre + 1:]
    gravar_texto(caminho, texto)


def modulos_ativos(dados):
    ativos = set()
    for secao in ORDEM:
        ativos.update(dados.get(secao, []))
    return {m: (m in ativos) for m, *_ in MODULOS}


def modulos_aplicar(dados, escolha):
    for nome, secao, *_ in MODULOS:
        ligado = escolha.get(nome)
        presente = [s for s in ORDEM if nome in dados.get(s, [])]
        if not ligado:
            for s in presente:
                dados[s] = [m for m in dados[s] if m != nome]
        elif not presente:
            lista = list(dados.get(secao, []))
            ordem = ORDEM[secao]
            # entra logo depois do último vizinho que vem antes dele no padrão VoidBR
            pos = 0
            for i, m in enumerate(lista):
                if m in ordem and ordem.index(m) < ordem.index(nome):
                    pos = i + 1
            lista.insert(pos, nome)
            dados[secao] = lista


def areas_waybar(wb):
    """(quantidade de áreas fixas na barra, formato) da sway/workspaces."""
    ws = wb.get("sway/workspaces", {}) if isinstance(wb.get("sway/workspaces"), dict) else {}
    fixas = ws.get("persistent-workspaces", {})
    qtd = len(fixas) if isinstance(fixas, dict) and fixas else 5
    return max(1, min(10, qtd)), ws.get("format", "{icon}")


def css_bloco(estilo, posicao, opacidade):
    a = max(0.3, min(1.0, opacidade / 100))
    fundo = f"linear-gradient(to top, rgba(22, 22, 30, {a:.2f}), rgba(36, 40, 59, {a:.2f}))"
    if estilo == "ilha":
        corpo = (f"window#waybar {{\n  background: {fundo};\n  border-radius: 20px;\n"
                 f"  border: none;\n  border-bottom: 3px solid rgba(22, 22, 30, {a:.2f});\n}}\n")
    else:
        lado = "bottom" if posicao == "top" else "top"
        corpo = (f"window#waybar {{\n  background: {fundo};\n  border-radius: 0;\n"
                 f"  border: none;\n  border-{lado}: 1px solid #2a2e42;\n}}\n")
    return (f"{CSS_INICIO}\n/* estilo: {estilo} | opacidade: {int(opacidade)} */\n"
            f"{corpo}{CSS_FIM}\n")


def css_ler():
    garantir_do_skel(WAYBAR_CSS, "waybar/style.css")
    texto = ler_texto(WAYBAR_CSS)
    m = re.search(r"/\* estilo: (\w+) \| opacidade: (\d+) \*/", texto)
    if m:
        return m.group(1), int(m.group(2))
    return "ilha", 100


def css_gravar(estilo, posicao, opacidade):
    texto = ler_texto(WAYBAR_CSS)
    bloco = css_bloco(estilo, posicao, opacidade)
    padrao = re.compile(re.escape(CSS_INICIO) + r".*?" + re.escape(CSS_FIM) + r"\n?", re.S)
    if padrao.search(texto):
        texto = padrao.sub(lambda _m: bloco, texto)
    else:  # no fim do arquivo: vale por cima das regras de antes
        texto = texto.rstrip("\n") + "\n\n" + bloco
    gravar_texto(WAYBAR_CSS, texto)


def margem(estilo, posicao):
    if estilo != "ilha":
        return 0
    return "6 10 0 10" if posicao == "top" else "0 10 6 10"


# ---------------------------------------------------------------------------
#   gsettings, nwg-look, xsettingsd e listas de temas
# ---------------------------------------------------------------------------

def gs_ler(chave, padrao=None):
    try:
        r = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", chave],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return padrao
    v = r.stdout.strip()
    if r.returncode != 0 or not v:
        return padrao
    if v.startswith("uint32 "):
        v = v[7:]
    return v.strip("'")


def gs_gravar(chave, valor):
    try:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", chave, str(valor)],
                       capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def _trocar_chaves(caminho, novos, separador):
    """Troca "chave<sep>valor" nas linhas do arquivo; o que faltar vai no fim."""
    saida, feitos = [], set()
    for linha in ler_texto(caminho).splitlines():
        s = linha.strip()
        k = None
        if s and not s.startswith("#"):
            k = s.split("=", 1)[0].strip() if separador == "=" else s.split(None, 1)[0]
        if k in novos:
            saida.append(f"{k}{separador}{novos[k]}")
            feitos.add(k)
        else:
            saida.append(linha)
    saida += [f"{k}{separador}{val}" for k, val in novos.items() if k not in feitos]
    gravar_texto(caminho, "\n".join(saida) + "\n")


def xsettingsd_gravar(v):
    garantir_do_skel(XSETTINGSD, "xsettingsd/xsettingsd.conf")
    _trocar_chaves(XSETTINGSD, {
        "Net/ThemeName": f'"{v["gtk"]}"',
        "Net/IconThemeName": f'"{v["icones"]}"',
        "Gtk/CursorThemeName": f'"{v["cursor"]}"',
        "Gtk/CursorThemeSize": str(v["cursor_tam"]),
        "Gtk/FontName": f'"{v["fonte_ui"]} {v["fonte_ui_tam"]}"',
    }, " ")
    sinal("xsettingsd", signal.SIGHUP)


def nwg_look_gravar(v):
    """O nwg-look mostra (e reaplica com nwg-look -a) o que está neste arquivo."""
    garantir_do_skel(NWG_LOOK, "nwg-look/gsettings", SKEL_DADOS)
    if not os.path.exists(NWG_LOOK):
        return
    _trocar_chaves(NWG_LOOK, {
        "gtk-theme": v["gtk"], "icon-theme": v["icones"],
        "font-name": f"{v['fonte_ui']} {v['fonte_ui_tam']}",
        "cursor-theme": v["cursor"], "cursor-size": v["cursor_tam"],
        "color-scheme": "prefer-dark" if v["escuro"] else "default",
    }, "=")


def _pastas(raizes, exige):
    nomes = set()
    for raiz in raizes:
        for d in glob.glob(os.path.join(raiz, "*")):
            if any(os.path.exists(os.path.join(d, e)) for e in exige):
                nomes.add(os.path.basename(d))
    return [(n, n) for n in sorted(nomes, key=str.lower)]


def temas_gtk():
    return _pastas(PASTAS_TEMAS, ("gtk-3.0", "gtk-4.0"))


def temas_cursor():
    return _pastas(PASTAS_ICONES, ("cursors",))


def temas_icones():
    nomes = set()
    for raiz in PASTAS_ICONES:
        for idx in glob.glob(os.path.join(raiz, "*", "index.theme")):
            if "Directories=" in ler_texto(idx):  # tema só de cursor não tem
                nomes.add(os.path.basename(os.path.dirname(idx)))
    return [(n, n) for n in sorted(nomes, key=str.lower)]


def papeis():
    lista, vistos = [], set()
    for pasta in PAPEL_PASTAS:
        for arq in sorted(glob.glob(os.path.join(pasta, "*")), key=str.lower):
            if not arq.lower().endswith(PAPEL_EXT) or os.path.islink(arq):
                continue
            real = os.path.realpath(arq)
            if real in vistos:
                continue
            vistos.add(real)
            nome = os.path.splitext(os.path.basename(arq))[0].replace("_", " ").replace("-", " ")
            lista.append((arq, nome))
    return lista


# ---------------------------------------------------------------------------
#   processos da sessão
# ---------------------------------------------------------------------------

def rodando(nome):
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", nome],
                          capture_output=True).returncode == 0


def sinal(nome, sig):
    subprocess.run(["pkill", f"-{int(sig)}", "-u", str(os.getuid()), "-x", nome],
                   capture_output=True)


def em_segundo_plano(cmd):
    """Sobe um programa que continua depois que o app fecha."""
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def sway_rodando():
    return bool(os.environ.get("SWAYSOCK")) and shutil.which("swaymsg") is not None


def swaymsg(*cmd):
    if not sway_rodando():
        return True
    r = subprocess.run(["swaymsg", *cmd], capture_output=True, text=True)
    return r.returncode == 0


def sway_recarregar(v=None):
    """swaymsg reload (janelas continuam) e reaplica nas janelas já abertas
    o que o sway só usaria nas novas: espaços e bordas."""
    if not sway_rodando():
        return
    swaymsg("reload")
    if v is not None:
        swaymsg(f"gaps inner all set {v['gaps_inner']}")
        swaymsg(f"gaps outer all set {v['gaps_outer']}")
        borda = v["borda"] if v["borda"] == "none" else f"{v['borda']} {v['borda_px']}"
        swaymsg(f"[tiling] border {borda}")
        swaymsg(f"[floating] border {borda}")


def waybar_recarregar():
    if rodando("waybar"):
        sinal("waybar", signal.SIGUSR2)  # relê config e style.css
    elif os.environ.get("WAYLAND_DISPLAY") and shutil.which("waybar"):
        em_segundo_plano(["waybar"])


# ---------------------------------------------------------------------------
#   valores atuais e aplicação
# ---------------------------------------------------------------------------

def valores_atuais():
    s = sway_ler()
    tc, tp = s["teclado"], s["touchpad"]
    wb = waybar_ler()
    estilo, opacidade = css_ler()
    qtd, formato = areas_waybar(wb)
    nomes = []
    for n in range(1, 11):
        nome = s["areas"].get(n, str(n))
        nomes.append(nome.split(":", 1)[1] if ":" in nome else nome)
    while len(nomes) > qtd and nomes[-1] == str(len(nomes)):
        nomes.pop()
    opcoes = [o for o in tc.get("xkb_options", "").split(",") if o]
    alternar = next((o for o in opcoes if o.startswith("grp:")), "")
    fonte_ui = gs_ler("font-name", "Sans 10") or "Sans 10"
    m = re.match(r"^(.*?)\s+(\d+(?:\.\d+)?)$", fonte_ui)
    fonte = s.get("fonte", "monospace 10")
    mf = re.match(r"^(.*?)\s+(\d+(?:\.\d+)?)$", fonte)
    cor = next((k for k, _r, c in CORES if c and c.lower() == s.get("cor")), "sway")
    try:
        velocidade = float(tp.get("pointer_accel", "0"))
    except ValueError:
        velocidade = 0.0
    try:
        cursor_tam = int(s.get("cursor_tam") or gs_ler("cursor-size", "24") or 24)
    except ValueError:
        cursor_tam = 24
    variante = tc.get("xkb_variant", "")
    return {
        # janelas
        "borda": s.get("borda", "normal") if s.get("borda") in dict(BORDAS) else "normal",
        "borda_px": s.get("borda_px", 2),
        "gaps_inner": s.get("gaps_inner", 0),
        "gaps_outer": s.get("gaps_outer", 0),
        "smart_gaps": sim(s.get("smart_gaps", "off")),
        "smart_borders": sim(s.get("smart_borders", "off")),
        "foco_mouse": s.get("focus_follows_mouse", "yes") != "no",
        "layout": s.get("workspace_layout", "default"),
        "fonte_nome": mf.group(1) if mf else fonte,
        "fonte_tam": int(float(mf.group(2))) if mf else 10,
        "cor": cor,
        # barra
        "estilo": estilo if estilo in dict(ESTILOS) else "ilha",
        "posicao": wb.get("position", "top") if wb.get("position") in dict(POSICOES) else "top",
        "altura": int(wb.get("height", 30) or 30),
        "opacidade": opacidade,
        "modulos": modulos_ativos(wb),
        # aparência
        "gtk": gs_ler("gtk-theme", VOIDBR_APARENCIA["gtk"]),
        "icones": gs_ler("icon-theme", VOIDBR_APARENCIA["icones"]),
        "cursor": s.get("cursor") or gs_ler("cursor-theme", VOIDBR_APARENCIA["cursor"]),
        "cursor_tam": cursor_tam,
        "fonte_ui": m.group(1) if m else fonte_ui,
        "fonte_ui_tam": int(float(m.group(2))) if m else 10,
        "escuro": gs_ler("color-scheme", "prefer-dark") == "prefer-dark",
        # papel de parede
        "papel": s.get("papel", ""),
        "papel_modo": s.get("papel_modo", "fill"),
        # teclado e touchpad
        "layouts": tc.get("xkb_layout", "br"),
        "variante": "" if variante == '""' else variante,
        "modelo": tc.get("xkb_model", "abnt2"),
        "alternar": alternar,
        "numlock": sim(tc.get("xkb_numlock", "disabled")),
        "repeticao": num(tc.get("repeat_rate"), 25),
        "atraso": num(tc.get("repeat_delay"), 600),
        "toque": sim(tp.get("tap", "enabled")),
        "natural": sim(tp.get("natural_scroll", "disabled")),
        "digitando": sim(tp.get("dwt", "enabled")),
        "velocidade": velocidade,
        # áreas de trabalho
        "areas_num": qtd,
        "areas_nomes": ", ".join(nomes),
        "areas_formato": formato if formato in dict(FORMATOS_AREAS) else "{icon}",
        "_xkb_opcoes": opcoes,
    }


GRUPOS = {
    "janelas": ("borda", "borda_px", "gaps_inner", "gaps_outer", "smart_gaps", "smart_borders",
                "foco_mouse", "layout", "fonte_nome", "fonte_tam", "cor"),
    "barra": ("estilo", "posicao", "altura", "opacidade", "modulos"),
    "aparencia": ("gtk", "icones", "cursor", "cursor_tam", "fonte_ui", "fonte_ui_tam", "escuro"),
    "papel": ("papel", "papel_modo"),
    "teclado": ("layouts", "variante", "modelo", "alternar", "numlock", "repeticao", "atraso"),
    "touchpad": ("toque", "natural", "digitando", "velocidade"),
    "areas": ("areas_num", "areas_nomes", "areas_formato"),
}
NOMES_GRUPOS = {"janelas": "janelas", "barra": "barra", "aparencia": "aparência",
                "papel": "papel de parede", "teclado": "teclado", "touchpad": "touchpad",
                "areas": "áreas de trabalho"}


def aplicar(v, antes, progresso=lambda _t: None):
    mudou = [g for g, chaves in GRUPOS.items() if any(v[k] != antes.get(k) for k in chaves)]
    if not mudou:
        return []
    sway_muda = set(TODAS) & set(mudou)

    if sway_muda:
        # o arquivo inteiro sai dos valores da tela: nada fica velho nele
        progresso("Conferindo e gravando a configuração do Sway…")
        tweaks_gravar(v)

    if "aparencia" in mudou:
        progresso("Aparência…")
        gs_gravar("gtk-theme", v["gtk"])
        gs_gravar("icon-theme", v["icones"])
        gs_gravar("cursor-theme", v["cursor"])
        gs_gravar("cursor-size", v["cursor_tam"])
        gs_gravar("font-name", f"{v['fonte_ui']} {v['fonte_ui_tam']}")
        gs_gravar("color-scheme", "prefer-dark" if v["escuro"] else "default")
        xsettingsd_gravar(v)
        nwg_look_gravar(v)

    barra = {"barra", "areas"} & set(mudou)
    if barra:
        progresso("Barra…")
        wb = waybar_ler()
        mudancas = {}
        if "barra" in mudou:
            modulos_aplicar(wb, v["modulos"])
            mudancas = {"position": v["posicao"], "height": v["altura"],
                        "margin": margem(v["estilo"], v["posicao"])}
            mudancas.update({s: wb.get(s, []) for s in ORDEM})
            css_gravar(v["estilo"], v["posicao"], v["opacidade"])
        if "areas" in mudou:
            ws = wb.get("sway/workspaces")
            ws = dict(ws) if isinstance(ws, dict) else {}
            nomes = [n.strip() for n in v["areas_nomes"].split(",")]
            ws["format"] = v["areas_formato"]
            ws["persistent-workspaces"] = {
                nome_area(n, nomes[n - 1] if n - 1 < len(nomes) else ""): []
                for n in range(1, v["areas_num"] + 1)}
            mudancas["sway/workspaces"] = ws
        waybar_gravar(mudancas)

    if sway_muda:
        progresso("Recarregando o Sway…")
        sway_recarregar(v)  # o reload do VoidBR já reinicia a Waybar (exec_always)
    if barra and not (sway_muda and sway_rodando()):
        waybar_recarregar()

    return [NOMES_GRUPOS[g] for g in mudou]


def fazer_backup():
    destino = os.path.join(BACKUP_DIR, datetime.datetime.now().strftime("%Y%m%d-%H%M%S"))
    for arq in (SWAY_CONF, TWEAKS_CONF, waybar_config(), WAYBAR_CSS, XSETTINGSD, NWG_LOOK):
        if os.path.exists(arq):
            base = DADOS if arq.startswith(DADOS + os.sep) else CONFIG
            rel = os.path.relpath(arq, base)
            if base == DADOS:
                rel = os.path.join("local-share", rel)
            os.makedirs(os.path.dirname(os.path.join(destino, rel)), exist_ok=True)
            shutil.copy2(arq, os.path.join(destino, rel))
    return destino


def restaurar(base, progresso=lambda _t: None):
    """base: "voidbr" (skel completo) ou "sway" (config original do sway)."""
    progresso("Guardando a configuração atual…")
    atual = valores_atuais()
    destino = fazer_backup()
    if base == "voidbr":
        progresso("Voltando ao padrão VoidBR…")
        for rel in ("sway/config", "waybar/config", "waybar/style.css",
                    "xsettingsd/xsettingsd.conf"):
            origem = os.path.join(SKEL, rel)
            if os.path.exists(origem):
                alvo = os.path.join(CONFIG, rel)
                os.makedirs(os.path.dirname(alvo), exist_ok=True)
                shutil.copy2(origem, alvo)
        origem = os.path.join(SKEL_DADOS, "nwg-look/gsettings")
        if os.path.exists(origem):
            os.makedirs(os.path.dirname(NWG_LOOK), exist_ok=True)
            shutil.copy2(origem, NWG_LOOK)
        velho = os.path.join(WAYBAR_DIR, "config.jsonc")
        if os.path.exists(velho):  # o VoidBR Sway usa o "config"
            os.rename(velho, velho + ".bak")
        sway_garantir_include()
        gravar_texto(TWEAKS_CONF, tweaks_texto({}, ()))  # vazio: vale o config do skel
        a = VOIDBR_APARENCIA
        for chave, val in (("gtk-theme", a["gtk"]), ("icon-theme", a["icones"]),
                           ("cursor-theme", a["cursor"]), ("cursor-size", a["cursor_tam"]),
                           ("font-name", f"{a['fonte_ui']} {a['fonte_ui_tam']}"),
                           ("color-scheme", "prefer-dark")):
            gs_gravar(chave, val)
        sinal("xsettingsd", signal.SIGHUP)
    else:
        progresso("Voltando ao padrão do Sway…")
        if os.path.exists(SWAY_ORIGINAL):
            shutil.copy2(SWAY_ORIGINAL, SWAY_CONF)
        sway_garantir_include()
        # teclado, touchpad, cursor e papel de parede continuam como estavam
        gravar_texto(TWEAKS_CONF, tweaks_texto(atual, ("teclado", "touchpad", "aparencia",
                                                       "papel")))
    sway_recarregar()
    if not sway_rodando():
        waybar_recarregar()
    return destino


# ---------------------------------------------------------------------------
#   interface
# ---------------------------------------------------------------------------

def _escolha(dd, opcoes, valor):
    for i, (v, _r) in enumerate(opcoes):
        if v == valor:
            dd.set_selected(i)
            return
    if valor not in (None, ""):
        # valor que não está na lista (ex.: tema removido): mostra mesmo assim
        rotulo = f"{os.path.basename(str(valor))} (atual)"
        opcoes.append((valor, rotulo))
        dd.get_model().append(rotulo)
        dd.set_selected(len(opcoes) - 1)


def familias_fonte(widget):
    try:
        nomes = sorted({f.get_name() for f in widget.get_pango_context().list_families()},
                       key=str.lower)
    except Exception:  # noqa: BLE001 - sem Pango: só as fontes do VoidBR
        nomes = []
    for n in ("Noto Sans", "Sans", "monospace", "DejaVu Sans", "Cantarell"):
        if n not in nomes:
            nomes.append(n)
    return [(n, n) for n in nomes]


class JanelaTweaks(Gtk.ApplicationWindow):
    def __init__(self, app, aba_inicial=None):
        super().__init__(application=app, title="VoidBR Sway Tweaks")
        self.set_default_size(740, 680)

        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(self.get_display(), prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.css_fonte = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(self.get_display(), self.css_fonte,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        try:
            self.escala_fonte = min(ESCALA_MAX, max(ESCALA_MIN,
                                                    float(ler_prefs_app().get("font_scale", 1.0))))
        except (TypeError, ValueError):
            self.escala_fonte = 1.0

        # --- cabeçalho: fonte à esquerda, menu à direita ---
        cab = Gtk.HeaderBar()
        cab.add_css_class("cabecalho-app")
        self.set_titlebar(cab)
        fonte = Gtk.Box()
        fonte.add_css_class("linked")
        self.b_menor = Gtk.Button(label="A−", tooltip_text="Diminuir a fonte (Ctrl -)")
        self.b_escala = Gtk.Button(label="100%", tooltip_text="Tamanho normal (Ctrl 0)")
        self.b_maior = Gtk.Button(label="A+", tooltip_text="Aumentar a fonte (Ctrl +)")
        for b, passo in ((self.b_menor, -1), (self.b_escala, 0), (self.b_maior, 1)):
            b.add_css_class("botao-fonte")
            b.connect("clicked", lambda _b, p=passo: self.mudar_fonte(p))
            fonte.append(b)
        cab.pack_start(fonte)

        menu = Gio.Menu()
        menu.append("📂 Abrir a pasta de configuração do Sway", "win.pasta")
        menu.append("🗂️ Abrir os backups do app", "win.backups")
        menu.append("ℹ️ Sobre / Créditos", "win.sobre")
        bmenu = Gtk.MenuButton(icon_name="open-menu-symbolic")
        bmenu.set_menu_model(menu)
        cab.pack_end(bmenu)
        for nome, cb in (("sobre", self.ao_clicar_sobre),
                         ("pasta", lambda *_: self.abrir_pasta(SWAY_DIR)),
                         ("backups", lambda *_: self.abrir_pasta(BACKUP_DIR)),
                         ("fonte_mais", lambda *_: self.mudar_fonte(1)),
                         ("fonte_menos", lambda *_: self.mudar_fonte(-1)),
                         ("fonte_normal", lambda *_: self.mudar_fonte(0))):
            acao = Gio.SimpleAction.new(nome, None)
            acao.connect("activate", cb)
            self.add_action(acao)
        app.set_accels_for_action("win.fonte_mais", ["<Control>plus", "<Control>equal",
                                                     "<Control>KP_Add"])
        app.set_accels_for_action("win.fonte_menos", ["<Control>minus", "<Control>KP_Subtract"])
        app.set_accels_for_action("win.fonte_normal", ["<Control>0", "<Control>KP_0"])
        self.aplicar_fonte()

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        caixa.add_css_class("conteudo")
        for lado in ("top", "bottom", "start", "end"):
            getattr(caixa, f"set_margin_{lado}")(16)
        self.set_child(caixa)

        titulo = Gtk.Label(label="🛠️ VoidBR Sway Tweaks", xalign=0)
        titulo.add_css_class("titulo-app")
        caixa.append(titulo)
        sub = Gtk.Label(label="Janelas, barra em ilha, aparência, papel de parede, teclado e "
                              "áreas de trabalho", xalign=0, wrap=True)
        sub.add_css_class("subtitulo")
        caixa.append(sub)

        self.abas = Gtk.Notebook(scrollable=True)
        self.abas.set_vexpand(True)
        self.indice_aba = {}
        for chave, rotulo, fabrica in (("janelas", "🪟 Janelas", self._aba_janelas),
                                       ("barra", "🧱 Barra", self._aba_barra),
                                       ("aparencia", "🎨 Aparência", self._aba_aparencia),
                                       ("papel", "🖼️ Papel de parede", self._aba_papel),
                                       ("teclado", "⌨️ Teclado e touchpad", self._aba_teclado),
                                       ("areas", "🗂️ Áreas de trabalho", self._aba_areas)):
            rolagem = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            rolagem.set_child(fabrica())
            self.indice_aba[chave] = self.abas.append_page(rolagem, Gtk.Label(label=rotulo))
        caixa.append(self.abas)

        st = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        st.add_css_class("caixa-status")
        self.label_status = Gtk.Label(label="", xalign=0, wrap=True)
        st.append(self.label_status)
        caixa.append(st)

        linha = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        b_sway = Gtk.Button(label="🔵 Padrão Sway",
                            tooltip_text="Volta o config ao original do Sway (atalhos, janelas e "
                                         "a swaybar do próprio Sway, sem nada do VoidBR). "
                                         "Teclado, touchpad, cursor e papel de parede continuam.")
        b_sway.add_css_class("botao-azul")
        b_sway.connect("clicked", lambda *_: self.confirmar_restaurar("sway"))
        b_voidbr = Gtk.Button(label="↩️ Padrão VoidBR",
                              tooltip_text="Volta ao visual VoidBR completo: barra em ilha, "
                                           "atalhos, tema e cores Tokyo Night.")
        b_voidbr.add_css_class("botao-laranja")
        b_voidbr.connect("clicked", lambda *_: self.confirmar_restaurar("voidbr"))
        self.b_restaurar = (b_sway, b_voidbr)
        self.b_aplicar = Gtk.Button(label="✅ Aplicar")
        self.b_aplicar.add_css_class("botao-verde")
        self.b_aplicar.connect("clicked", self.ao_clicar_aplicar)
        for b in (b_sway, b_voidbr, self.b_aplicar):
            linha.append(b)
        caixa.append(linha)

        self.recarregar()
        if aba_inicial in self.indice_aba:
            self.abas.set_current_page(self.indice_aba[aba_inicial])

    # ----- blocos de interface -----

    def _grade(self, titulo=None):
        g = Gtk.Grid(column_spacing=14, row_spacing=10)
        for lado in ("top", "bottom", "start", "end"):
            getattr(g, f"set_margin_{lado}")(14)
        g._linha = 0
        if titulo:
            self._secao(g, titulo)
        return g

    def _secao(self, g, texto):
        s = Gtk.Label(label=texto, xalign=0)
        s.add_css_class("secao")
        g.attach(s, 0, g._linha, 3, 1)
        g._linha += 1

    def _rotulo(self, g, texto, dica=None):
        r = Gtk.Label(label=texto, xalign=0, hexpand=True)
        r.add_css_class("rotulo-campo")
        g.attach(r, 0, g._linha, 1, 1)
        if dica:
            d = Gtk.Label(label=dica, xalign=0, wrap=True)
            d.add_css_class("dica")
            g.attach(d, 0, g._linha + 1, 3, 1)

    def _avanca(self, g, dica):
        g._linha += 2 if dica else 1

    def _chave(self, g, texto, dica=None):
        self._rotulo(g, texto, dica)
        sw = Gtk.Switch(halign=Gtk.Align.END, valign=Gtk.Align.CENTER)
        g.attach(sw, 1, g._linha, 2, 1)
        self._avanca(g, dica)
        return sw

    def _lista(self, g, texto, opcoes, dica=None, busca=False):
        self._rotulo(g, texto, dica)
        dd = Gtk.DropDown.new_from_strings([r for _v, r in opcoes])
        dd._opcoes = opcoes
        if busca:
            dd.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
            dd.set_enable_search(True)
        g.attach(dd, 1, g._linha, 2, 1)
        self._avanca(g, dica)
        return dd

    def _texto(self, g, texto, dica=None, exemplo=""):
        self._rotulo(g, texto, dica)
        e = Gtk.Entry(placeholder_text=exemplo, width_chars=18)
        g.attach(e, 1, g._linha, 2, 1)
        self._avanca(g, dica)
        return e

    def _escala(self, g, texto, minimo, maximo, passo=1, sufixo="", dica=None, casas=0):
        self._rotulo(g, texto, dica)
        esc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, minimo, maximo, passo)
        esc.set_size_request(220, -1)
        esc.set_draw_value(False)
        val = Gtk.Label(xalign=1, width_chars=7)
        esc.connect("value-changed",
                    lambda e: val.set_text(f"{e.get_value():.{casas}f}{sufixo}"))
        g.attach(esc, 1, g._linha, 1, 1)
        g.attach(val, 2, g._linha, 1, 1)
        self._avanca(g, dica)
        return esc

    def _aviso(self, g, texto):
        a = Gtk.Label(label=texto, xalign=0, wrap=True)
        a.add_css_class("aviso")
        g.attach(a, 0, g._linha, 3, 1)
        g._linha += 1

    @staticmethod
    def _valor_dd(dd):
        i = dd.get_selected()
        return dd._opcoes[i][0] if 0 <= i < len(dd._opcoes) else None

